{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist-types",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-types/tsconfig.tsbuildinfo",
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["dist", "dist-types", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
