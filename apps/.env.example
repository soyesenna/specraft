# Specraft apps environment
# Copy values into your shell, deployment environment, or a local .env loader.
# Do not commit real secrets.

# Backend server
# Required. Used to derive the session-cookie key and credential-encryption key.
# Generate for production with: openssl rand -base64 48
SPECRAFT_SECRET=replace-with-32-plus-random-chars

# Optional. Backend bind address and port.
# Root pnpm dev uses 4174 to match the frontend proxy; backend code defaults to 4311.
HOST=127.0.0.1
PORT=4174

# Optional. Root directory for SQLite, wiki.git, code-mirror.git, and worktrees.
# Docker uses /data; local development can use a temp directory.
SPECRAFT_DATA_DIR=/tmp/specraft-dev-data

# Optional. Preferred code repository remote URL. GIT_REMOTE_URL is the legacy fallback.
SPECRAFT_CODE_REMOTE_URL=
GIT_REMOTE_URL=

# Required. Specraft v1 requires LLM behavior, and OpenRouter is the only provider.
OPENROUTER_API_KEY=sk-or-v1-replace-with-openrouter-key
OPENROUTER_MODEL=openrouter/auto

# Frontend app
# Optional. Browser-visible API base URL. Leave empty to use the current origin/proxy.
VITE_SPECRAFT_API_BASE_URL=

# Optional. Vite dev-server /api proxy target.
SPECRAFT_DEV_API_TARGET=http://127.0.0.1:4174
