{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.js\"",
            "timeout": 10,
            "statusMessage": "Specraft: Injecting spec context"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/post-compact.js\"",
            "timeout": 10,
            "statusMessage": "Specraft: Re-injecting spec context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/user-prompt-submit.js\"",
            "timeout": 5,
            "statusMessage": "Specraft: Checking pending replay"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/pre-tool-use.js\"",
            "timeout": 10,
            "statusMessage": "Specraft: Checking branch locks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/post-tool-use.js\"",
            "timeout": 10,
            "statusMessage": "Specraft: Linking spec pages"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/stop.js\"",
            "timeout": 10,
            "statusMessage": "Specraft: Checking stop gate"
          }
        ]
      }
    ]
  }
}
