{
  "name": "@specraft/mcp-proxy",
  "version": "0.1.0",
  "description": "Specraft MCP stdio proxy: branch-aware spec wiki tools (query/ingest/status/defer) and stop-gate hooks for Claude Code and Codex.",
  "type": "module",
  "bin": {
    "specraft-mcp-proxy": "dist-bundle/cli.js"
  },
  "files": [
    "dist-bundle"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm bundle",
    "bundle": "tsup && node scripts/copy-bundle.mjs",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "pnpm --filter @specraft/shared build && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@specraft/shared": "workspace:*",
    "tsup": "^8.5.0",
    "zod": "4.4.3"
  }
}
